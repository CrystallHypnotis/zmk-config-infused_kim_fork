if SHIELD_CORNE_TP_DONGLE

config ZMK_KEYBOARD_NAME
    default "Corne TP dongle"

config ZMK_SPLIT_BLE_ROLE_CENTRAL
    default y

config ZMK_USB
    default y

config ZMK_SPLIT
    default y

config ZMK_BLE
    default y

endif

# Options that should be enabled on both sides
if SHIELD_CORNE_TP_LEFT || SHIELD_CORNE_TP_RIGHT

config ZMK_SPLIT
    default y

config ZMK_BLE
    default y

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif

# Force-disable the original PS/2 input listener unless mouse driver is active.
# This prevents compilation of input_listener_ps2.c on peripheral (where
# ZMK_INPUT_MOUSE_PS2=n due to depends on central role), avoiding errors
# from zmk_keymap_layer_activate() 1-arg vs 2-arg signature mismatch.
config ZMK_INPUT_LISTENER_PS2
	depends on ZMK_INPUT_MOUSE_PS2
