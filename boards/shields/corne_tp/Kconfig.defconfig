if SHIELD_CORNE_TP_DONGLE

config ZMK_KEYBOARD_NAME
    default "Corne TP dongle"

config ZMK_SPLIT_BLE_ROLE_CENTRAL
    default y

config ZMK_USB
    default y

config ZMK_SPLIT
    default y

config ZMK_BLE
    default y

endif

# Options that should be enabled on both sides
if SHIELD_CORNE_TP_LEFT || SHIELD_CORNE_TP_RIGHT

config ZMK_SPLIT
    default y

config ZMK_BLE
    default y

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif

# Enable urob compatibility on peripheral too.
# The original PS/2 listener uses UROB_COMPAT to call zmk_keymap_layer_activate()
# with correct 2-arg signature (layer, sensor) vs broken 1-arg.
# This config is normally inside `if ZMK_INPUT_MOUSE_PS2` in the module's Kconfig,
# but ZMK_INPUT_MOUSE_PS2=n on peripheral. We define it unconditionally here.
config ZMK_INPUT_MOUSE_PS2_ENABLE_UROB_COMPAT
	bool
	default y
