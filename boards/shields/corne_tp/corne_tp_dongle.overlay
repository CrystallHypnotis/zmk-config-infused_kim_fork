#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan_mock;
        zmk,matrix-transform = &default_transform;
    };

    kscan_mock: kscan_mock {
        compatible = "zmk,kscan-mock";
        rows = <4>;
        columns = <12>;
        events = <0x00636300>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                        RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
        >;
    };

    // Split input transport - receives forwarded mouse events from peripheral
    input_split: input_split {
        compatible = "zmk,input-split";
        status = "okay";
    };

    // Central-side input listener for forwarded peripheral mouse events
    split_central_listener: split_central_listener {
        compatible = "zmk,input-listener-split-central";
        status = "okay";
        device = <&input_split>;
    };
};
